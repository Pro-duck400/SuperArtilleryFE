{
  "name": "superartillery",
  "private": true,
  "version": "1.3.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:contracts": "npm --prefix .. run contracts:generate",
    "build": "npm run generate:contracts && tsc && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "jsdom": "^26.1.0",
    "typescript": "^7.0.2",
    "vite": "^7.2.4",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
