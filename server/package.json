{
  "name": "superartillery-server",
  "version": "1.2.3",
  "description": "SuperArtillery WebSocket game server",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx src/server.ts",
    "generate:contracts": "npm --prefix .. run contracts:generate",
    "build": "npm run generate:contracts && tsc",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "game",
    "websocket",
    "artillery"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.18.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@scarf/scarf@1.4.0": true
  }
}
